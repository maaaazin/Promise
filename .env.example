# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Required. Powers the CopilotKit runtime (/app/api/copilotkit/route.ts) — the sidebar,
# every registered action, and (in a later pass) extraction/drafting all call OpenAI through
# this key. Without it, OpenAIAdapter has no credentials and every agent call hard-fails.
OPENAI_API_KEY=

# Optional (stretch feature). Enables Exa enrichment of escalation drafts with live external
# context. Not implemented yet — currently unused by any code. Leave unset until that lands.
EXA_API_KEY=

# Optional. Slack Incoming Webhook URL used by lib/slack.ts to deliver approved escalations.
# If unset, approved messages are logged in-app in demo mode instead of being sent — nothing
# crashes and no other feature is affected.
SLACK_WEBHOOK_URL=
